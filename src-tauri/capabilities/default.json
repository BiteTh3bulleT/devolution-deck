{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for DEVOLUTION//DECK",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$RESOURCE/**" },
        { "path": "$HOME/Music/**" },
        { "path": "$HOME/Documents/**" },
        { "path": "$HOME/Downloads/**" },
        { "path": "$TEMP/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$HOME/Music/**" },
        { "path": "$HOME/Documents/**" },
        { "path": "$HOME/Downloads/**" },
        { "path": "$TEMP/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$RESOURCE/**" },
        { "path": "$HOME/Music/**" },
        { "path": "$HOME/Documents/**" },
        { "path": "$HOME/Downloads/**" },
        { "path": "$TEMP/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$HOME/Music/**" },
        { "path": "$HOME/Documents/**" },
        { "path": "$HOME/Downloads/**" },
        { "path": "$TEMP/**" }
      ]
    },
    "fs:allow-exists",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$HOME/Music/**" },
        { "path": "$HOME/Documents/**" },
        { "path": "$HOME/Downloads/**" },
        { "path": "$TEMP/**" }
      ]
    },
    "fs:allow-copy-file",
    "fs:allow-rename",
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$TEMP/**" }
      ]
    }
  ]
}
